{
  "target": "linux/amd64",
  "http": ":{{MANAGER_PORT}}",
  "workdir": "{{FUZZ_WORKDIR}}",
  "kernel_obj": "{{CONTAINER_LINUX_ROOT}}",
  "kernel_src": "{{CONTAINER_LINUX_ROOT}}",
  "module_obj": [
    "{{CONTAINER_LINUX_ROOT}}/drivers"
  ],
  "image": "image/bullseye.img",
  "sshkey": "image/bullseye.id_rsa",
  "syzkaller": "syzkaller",
  "procs": 1,
  "reproduce": false,
  "type": "qemu",
  "sandbox": "none",
  "fuzzing_vms": 1,
  "preserve_corpus": false,
  "remote_kocv_bridge": "trace_workqueue=1 trace_timers=1",
  "vm": {
    "count": 4,
    "qemu": "{{CONTAINER_QEMU}}",
    "kernel": "{{CONTAINER_LINUX_ROOT}}/arch/x86/boot/bzImage",
    "cmdline": "nokaslr",
    "cpu": 2,
    "mem": 4096,
    "network_device": "e1000e",
    "qemu_args": "-enable-kvm -cpu host,migratable=off -netdev user,id=vmxnet3net,restrict=on -device vmxnet3,netdev=vmxnet3net,mac=52:54:00:12:34:56,addr=6.0"
  },
  "env": {
    "SFP_DEV_MODEL": "{{DRIVER}}",
    "SFP_VID": "{{VID}}",
    "SFP_PID": "{{PID}}",
    "WAITGDB": 0,
    "AP_DUMP_RW": 0,
    "USE_DMA": 1,
    "AFL_EPOCH": 5,
    "USE_STAGE2": 1,
    "TEST_PROBE": 1,
    "MODEL_PROBE_FUZZ": 1,
    "MODEL_RESET_TIME": 1,
    "MODEL_MUTATE_PROB": 50,
    "AP_DISABLED": 0
  },
  "ignores": [
    "WARNING: The mand mount option has been deprecated and",
    "WARNING: fbcon: Driver 'bochs-drmdrmfb' missed to adjust virtual screen size*",
    "WARNING: fbcon: Driver 'vkmsdrmfb' missed to adjust virtual screen size*",
    "INFO:*",
    "WARNING: in kcov_remote_stop",
    "WARNING: CPU: .* intel_sseu_get_hsw_subslices.*",
    "WARNING in intel_sseu_get_hsw_subslices"
  ],
  "disable_syscalls": [],
  "enable_syscalls": ["{{ENABLE_SYSCALLS}}"]
}
