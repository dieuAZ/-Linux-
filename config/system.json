      "svf_analyzer": "/media/iotteam/hd/pyh/mi/scripts/analyse/svf_backend/build/svf_backward_analyzer",
      "wpa": "/media/iotteam/hd/pyh/mi/tools/SVF/Release-build/bin/wpa",
      "extract_functions": "/media/iotteam/hd/pyh/mi/scripts/driver_fix/extract_functions.py",
      "generate_mmio_arrays": "/media/iotteam/hd/pyh/mi/scripts/driver_fix/generate_mmio_arrays.py",
      "svf_find_sv_alias": "/media/iotteam/hd/pyh/mi/scripts/driver_fix/svf_find_sv_alias.py"
