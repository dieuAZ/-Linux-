# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

WORKDIR /media/iotteam/hd/html/syzkaller-workbench-realtime-dashboard-20261013

# These contexts are snapshots of the running container's visible files, not
# host bind mounts. The workbench context includes its active /data directory.
COPY --from=workbench . /media/iotteam/hd/html/syzkaller-workbench-realtime-dashboard-20261013/
COPY --from=lx-codeql . /media/iotteam/hd/lx/codeql/
COPY --from=lx-db . /media/iotteam/hd/lx/codeql-db/
COPY --from=lx-query . /media/iotteam/hd/lx/static-query-6.1/
COPY --from=lx-ops . /media/iotteam/hd/lx/ops/ops-concurrency/
COPY --from=lx-linux726 . /media/iotteam/hd/lx/linux-7.2.6/

RUN chmod +x ./container_entry.sh \
    && test -x /media/iotteam/hd/lx/codeql/codeql \
    && test -d /media/iotteam/hd/lx/codeql-db \
    && test -d /media/iotteam/hd/lx/linux-7.2.6/drivers \
    && test -s /media/iotteam/hd/pyh/mi/image/bullseye.img \
    && test -f ./data/tasks.db \
    && test -x ./container_entry.sh

ENTRYPOINT ["./container_entry.sh"]
